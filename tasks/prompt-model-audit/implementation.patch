+        QualityVerification(success=True, overall_status="fail", recommendation="regenerate"),
+    ):
+        state = {
+            "sku": "br-001",
+            "status": "running",
+            "quality_result": qc,
+            "retry_count": 2,
+            "max_retries": 2,
+            "enable_compositor": True,
