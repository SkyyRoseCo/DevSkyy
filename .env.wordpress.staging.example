# WordPress.com STAGING deployment configuration
# Copy to .env.wordpress.staging and fill in the staging credentials.
# Consumed by scripts/deploy-staging.sh (which refuses unless PUBLIC_URL is a
# *.wpcomstaging.com host and WP_THEME_PATH ends in skyyrose-flagship-2).
# Staging host [live 2026-09-18]: staging-7e48-skyyrose.wpcomstaging.com
# (staging.skyyrose.co / staging.skyyrose.com do not resolve).

# WordPress.com Atomic deployment bridge (staging site)
# SSH_USER MUST equal "<first label of the PUBLIC_URL host>.wordpress.com"
# (staging-7e48-skyyrose.wpcomstaging.com -> staging-7e48-skyyrose.wordpress.com);
# the wrappers and the engine refuse any other value.
SSH_HOST=ssh.wp.com
SSH_PORT=22
SSH_USER=staging-7e48-skyyrose.wordpress.com
SSH_PASS=your_staging_ssh_password_here
WP_THEME_PATH=/htdocs/wp-content/themes/skyyrose-flagship-2

# SFTP uses same creds (lftp connects via sftp://). The engine's preflight
# REQUIRES SFTP_HOST / SFTP_USER / SFTP_PASS, and SFTP_USER must equal SSH_USER.
SFTP_HOST=ssh.wp.com
SFTP_PORT=22
SFTP_USER=staging-7e48-skyyrose.wordpress.com
SFTP_PASS=your_staging_sftp_password_here

# WP-CLI over SSH
WP_CLI_SSH=staging-7e48-skyyrose.wordpress.com@ssh.wp.com

# WordPress.com staging site
WORDPRESS_SITE_URL=https://staging-7e48-skyyrose.wpcomstaging.com
WORDPRESS_URL=https://staging-7e48-skyyrose.wpcomstaging.com
# Site URL the deploy engine verifies against (falls back to WORDPRESS_URL).
PUBLIC_URL=https://staging-7e48-skyyrose.wpcomstaging.com/
