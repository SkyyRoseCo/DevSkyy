# WordPress.com Integration Configuration
# Copy to .env and fill in your credentials

# WordPress.com Atomic deployment bridge
SSH_HOST=ssh.wp.com
SSH_PORT=22
SSH_USER=skyyrose.wordpress.com
SSH_PASS=your_ssh_password_here
# Live theme folder. Pre-cutover this is skyyrose-flagship (which today holds
# Flagship 2 2.3.1); the cutover's first step switches it to skyyrose-flagship-2.
# scripts/deploy-production.sh refuses until the basename is skyyrose-flagship-2.
WP_THEME_PATH=/htdocs/wp-content/themes/skyyrose-flagship-2

# SFTP uses same creds (lftp connects via sftp://)
SFTP_HOST=ssh.wp.com
SFTP_PORT=22
SFTP_USER=skyyrose.wordpress.com
SFTP_PASS=your_sftp_password_here

# WP-CLI over SSH
WP_CLI_SSH=skyyrose.wordpress.com@ssh.wp.com

# WordPress.com Site
WORDPRESS_SITE_URL=https://skyyrose.co
WORDPRESS_URL=https://skyyrose.co
# Site URL the deploy engine verifies against (falls back to WORDPRESS_URL).
# deploy-production.sh refuses unless this host is skyyrose.co.
PUBLIC_URL=https://skyyrose.co/

# WordPress.com OAuth2 Token
# Get from: https://developer.wordpress.com/apps/
WORDPRESS_API_TOKEN=your_oauth2_token_here

# WooCommerce REST API Credentials
# Get from: WP Admin > WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_KEY=ck_xxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_SECRET=cs_xxxxxxxxxxxxxxxxxxxxx

# WooCommerce Webhook Secret (for signature verification)
# Set this when creating webhooks in WooCommerce
WC_WEBHOOK_SECRET=your_webhook_secret_here
