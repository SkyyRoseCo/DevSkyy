# Capture the ref list git hands pre-push on stdin ONCE, up front. git-lfs below
# consumes stdin; the secrets gate after it needs the same refs, and a second
# read would get EOF and scan nothing (fail-open). Both consumers get a copy.
_push_refs="$(cat)"

# git-lfs (managed by husky) — run if installed; don't short-circuit the rest.
if command -v git-lfs > /dev/null 2>&1; then
  printf '%s\n' "$_push_refs" | git lfs pre-push "$@" || exit $?
fi

# ── secrets gate (fail-closed, bug-230) ──
# gitleaks scans exactly the commits being pushed, per ref line:
#   new branch  → commits not on any remote (<local> --not --remotes)
#   update      → <remote-sha>..<local-sha>      deletion → skipped
# Blocks on a finding, on a missing/broken gitleaks (brew install gitleaks) and
# on an unreadable .gitleaks.toml. Prefers the pushing worktree's
# scripts/secret-scan.sh, else the hook owner's copy (the global core.hooksPath
# runs the MAIN checkout's hooks in every worktree).
# Bypass ONE push, loudly logged: SECRETS_SCAN_SKIP=1 git push …
_ss_root="$(git rev-parse --show-toplevel 2> /dev/null || echo "$PWD")"
_ss="$_ss_root/scripts/secret-scan.sh"
[ -f "$_ss" ] || _ss="$(dirname "$0")/../scripts/secret-scan.sh"
if [ ! -f "$_ss" ]; then
  if [ "${SECRETS_SCAN_SKIP:-0}" = "1" ]; then
    echo "⚠ secret-scan (pre-push): SECRETS_SCAN_SKIP=1 and scripts/secret-scan.sh is missing — gate BYPASSED for this push" >&2
  else
    echo "✗ secret-scan (pre-push): scripts/secret-scan.sh not found in $_ss_root or beside this hook — the secrets gate cannot run (fail-closed)." >&2
    echo "  Restore it: git checkout origin/main -- scripts/secret-scan.sh   Bypass this ONE push: SECRETS_SCAN_SKIP=1" >&2
    exit 1
  fi
elif ! printf '%s\n' "$_push_refs" | bash "$_ss" push --hook pre-push --repo "$_ss_root" --remote "$1"; then
  exit 1
fi

# ── ci-local stopgap: offline CI mirror while GitHub Actions is billing-blocked ──
# Runs WordPress `php -l` against the WORKTREE BEING PUSHED — a fast, deterministic
# syntax gate while the cloud pipeline is paused. Safe across every worktree sharing
# this hook (core.hooksPath is an absolute path), via two gates:
#   1. .ci-local-gate present in the pushing worktree → opt-in ("one rm" to disable)
#   2. a ci-local.sh is resolvable                    → else skip
# The script is resolved branch-independently: prefer the pushing worktree's own
# copy (present on branches that have merged the CI tooling), else fall back to the
# canonical ci-mirror worktree. CI_LOCAL_ROOT="$PWD" makes the canonical script
# check THIS worktree, not its own. The fallback path stops being needed once the
# tooling reaches main (every branch then has scripts/ci-local.sh) — self-healing.
# Python lint is intentionally NOT push-gated (repo-wide ruff/black/isort drift
# would false-block unrelated pushes — run `bash scripts/ci-local.sh lint` on demand).
# Bypass a single push with `git push --no-verify`. Remove this block (or the gate
# files) once GitHub Actions billing is restored.
if [ -f .ci-local-gate ]; then
  _ci_script="$(git rev-parse --show-toplevel 2> /dev/null)/scripts/ci-local.sh"
  [ -f "$_ci_script" ] || _ci_script="/Users/theceo/DevSkyy/scripts/ci-local.sh"
  if [ -f "$_ci_script" ]; then
    echo "ci-local stopgap: running fast pre-push checks (rm .ci-local-gate to disable)…"
    if ! CI_LOCAL_ROOT="$PWD" bash "$_ci_script" wordpress-theme; then
      echo "✗ ci-local pre-push failed — fix it, or 'git push --no-verify' to bypass, or 'rm .ci-local-gate' to disable."
      exit 1
    fi
  fi
fi

# ── session handoff log gate (CLAUDE.md / AGENTS.md "Session handoff log") ──
# Tool-agnostic backstop for agents with no Stop-hook support (Gemini CLI, Cursor,
# Aider, …): pushing a branch requires a row for it — `@ <branch>` dated today or
# yesterday — in the MAIN checkout's .wolf/memory.md, so parallel agents can see
# what landed. Claude Code and Codex are gated earlier by .wolf/hooks/handoff-gate.sh.
# Bypass one push: WOLF_HANDOFF_SKIP=1 git push   (or --no-verify).
if [ "${WOLF_HANDOFF_SKIP:-0}" != "1" ]; then
  _wolf_branch="$(git symbolic-ref --short -q HEAD 2> /dev/null)"
  _wolf_main="$(git worktree list --porcelain 2> /dev/null | awk '/^worktree /{print substr($0, 10); exit}')"
  _wolf_mem="$_wolf_main/.wolf/memory.md"
  if [ -n "$_wolf_branch" ] && [ -f "$_wolf_mem" ]; then
    _wolf_today="$(date '+%Y-%m-%d')"
    _wolf_yday="$(date -v-1d '+%Y-%m-%d' 2> /dev/null || date -d yesterday '+%Y-%m-%d' 2> /dev/null)"
    if ! grep -F "@ $_wolf_branch " "$_wolf_mem" | grep -Eq "^\| ($_wolf_today|${_wolf_yday:-$_wolf_today}) "; then
      echo "✗ handoff log: no row for branch '$_wolf_branch' dated today/yesterday in $_wolf_mem"
      echo "  Append one (format in CLAUDE.md / AGENTS.md → Session handoff log), e.g.:"
      echo "  | $_wolf_today $(date '+%H:%M') | <agent> @ $_wolf_branch sid:<id8> | what you did | files / PRs | done · in-progress · blocked + next step | ~tokens |"
      echo "  Bypass once: WOLF_HANDOFF_SKIP=1 git push"
      exit 1
    fi
  fi
fi
