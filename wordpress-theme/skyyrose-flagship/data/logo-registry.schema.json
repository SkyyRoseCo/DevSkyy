{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyyrose.co/schemas/product-registry-2.json",
  "title": "SkyyRose product registry",
  "description": "The single editable product SOT. products[sku] owns commerce fields, garment facts, the founder's design specification, and image/source bindings; logos and sku_logos own graphic identities, placements, and decoration dimensions. The CSV, dossier Markdown, sot-images.json, and every collection manifest are generated projections of this file. Founder/maker corrections govern and land here first. Validated by scripts/organize_product_registry.py; edit this registry, then run scripts/sync_product_registry.py.",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "updated",
    "product_registry_schema_version",
    "authority_contract",
    "brand_primary",
    "products",
    "catalog_columns",
    "logos",
    "sku_logos"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Prose statement of what this file governs. Kept for readers who open the raw JSON."
    },
    "version": {
      "type": ["integer", "string"],
      "description": "Registry revision. Currently an integer; strings accepted for forward compatibility."
    },
    "updated": { "type": "string", "format": "date" },
    "product_registry_schema_version": { "type": "integer", "minimum": 1 },
    "authority_contract": {
      "type": "object",
      "description": "The founder-authority rule this file is governed by."
    },
    "brand_primary": { "type": "string" },

    "brand": {
      "type": "object",
      "description": "Schema v2: brand identity absorbed from the canon docs.",
      "properties": {
        "tagline": { "type": "string" },
        "tokens": { "type": "object" },
        "typography_ref": { "type": "string" }
      }
    },
    "collections": {
      "type": "object",
      "description": "Schema v2: per-collection identity (story, palette, fonts, lockup, hero imagery), folded in from the retired data/collections/<slug>/identity.json files. Each entry is validated in full against data/collections/identity.schema.json by sot_common.load_identity(); this schema only pins the keys that identify it.",
      "propertyNames": { "$ref": "#/$defs/collectionSlug" },
      "additionalProperties": {
        "type": "object",
        "required": ["slug", "key", "name", "status"]
      }
    },

    "products": {
      "type": "object",
      "description": "Every product, keyed by canonical SKU.",
      "propertyNames": { "$ref": "#/$defs/sku" },
      "additionalProperties": { "$ref": "#/$defs/product" }
    },

    "catalog_columns": {
      "type": "array",
      "description": "Column order of the generated CSV projection. Order is the contract.",
      "items": { "type": "string" },
      "minItems": 1
    },

    "logos": { "type": "object" },
    "sku_logos": { "type": "object" },
    "sku_folders": { "type": "object" },
    "render_components": { "type": "object" },
    "render_source_aliases": { "type": "object" },
    "three_rose_cluster_colorways": { "type": "object" },
    "jersey_patch_standard": { "type": "object" },
    "gaps": { "type": ["object", "array"] },
    "changelog": { "type": ["object", "array"] }
  },
  "additionalProperties": false,

  "$defs": {
    "sku": {
      "type": "string",
      "pattern": "^(br|lh|sg|kids)-[0-9]{3}$",
      "description": "Canonical SKU. Kids products are kids-00N, never kc-00N."
    },
    "collectionSlug": {
      "type": "string",
      "enum": ["black-rose", "kids-capsule", "love-hurts", "signature"]
    },
    "boolString": {
      "type": "string",
      "enum": ["0", "1"],
      "description": "CSV-projected boolean. String, not bool -- the CSV is the consumer."
    },
    "sourcedSpec": {
      "type": "object",
      "description": "A founder-authored garment fact plus the source it came from.",
      "required": ["specification", "source"],
      "properties": {
        "specification": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "copyField": {
      "type": "object",
      "description": "One field of product copy and its writer.",
      "required": ["value", "authority", "source", "updated"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["FOUNDER_AUTHORED", "AGENT_GENERATED"] },
        "source": { "type": "string", "minLength": 1 },
        "updated": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "imageBinding": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^assets/" },
        "resolved": { "type": "string" }
      },
      "additionalProperties": false
    },

    "product": {
      "type": "object",
      "description": "One product. Section order is catalog, garment, dossier, images, render_sources, then the v2 sections, then authority.",
      "required": [
        "catalog",
        "garment",
        "dossier",
        "images",
        "render_sources",
        "authority"
      ],
      "properties": {
        "catalog": { "$ref": "#/$defs/catalog" },
        "merchandising": {
          "type": "object",
          "description": "Current route configuration; not a founder garment specification.",
          "required": ["series_slug", "series_region", "series_order"],
          "properties": {
            "series_slug": { "type": "string" },
            "series_region": { "type": "string" },
            "series_order": { "type": "integer" }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "series_slug": { "const": "" },
                "series_region": { "const": "" },
                "series_order": { "const": 0 }
              }
            },
            {
              "properties": {
                "series_slug": { "const": "jersey-series" },
                "series_region": { "enum": ["oakland", "san-francisco", "san-jose"] },
                "series_order": { "minimum": 1 }
              }
            }
          ]
        },
        "merchandising_provenance": {
          "type": "object",
          "required": ["source", "kind"],
          "properties": {
            "source": { "type": "string", "pattern": "\\S" },
            "kind": { "const": "ROUTE_CONFIGURATION" }
          },
          "additionalProperties": false
        },
        "garment": { "$ref": "#/$defs/garment" },
        "dossier": {
          "type": "object",
          "required": ["slug", "content"],
          "properties": {
            "slug": { "type": "string", "minLength": 1 },
            "content": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "images": {
          "type": "object",
          "description": "Image bindings. image and front_model_image are required; back roles are declared absent rather than substituted.",
          "required": ["image", "front_model_image"],
          "properties": {
            "image": { "$ref": "#/$defs/imageBinding" },
            "front_model_image": { "$ref": "#/$defs/imageBinding" },
            "back_image": { "$ref": "#/$defs/imageBinding" },
            "back_model_image": { "$ref": "#/$defs/imageBinding" }
          },
          "additionalProperties": false
        },
        "render_sources": {
          "type": "object",
          "required": ["reference"],
          "properties": {
            "reference": { "type": "string" },
            "front": { "type": ["string", "null"] },
            "back": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },

        "content": {
          "type": "object",
          "description": "Schema v2: product copy beyond catalog.description. Written through product_registry.update_product_content, one field at a time; each field records who wrote it, so agent copy is never mistaken for the founder's words. An absent field is absent, never an empty string. alt_text maps a registry-bound image's file stem to its alt text and writer.",
          "properties": {
            "description": { "$ref": "#/$defs/copyField" },
            "short_description": { "$ref": "#/$defs/copyField" },
            "seo_meta": { "$ref": "#/$defs/copyField" },
            "instagram": { "$ref": "#/$defs/copyField" },
            "tiktok": { "$ref": "#/$defs/copyField" },
            "alt_text": {
              "type": "object",
              "description": "Alt text keyed by the file stem of a registry-bound image of this product. Written via product_registry.update_product_alt_text, which refuses unbound images.",
              "additionalProperties": { "$ref": "#/$defs/copyField" }
            }
          },
          "additionalProperties": false
        },
        "corrections": {
          "type": "array",
          "description": "Schema v2: render corrections injected into every render prompt for this SKU, folded in from render-corrections.json. Wording is preserved exactly, including the mechanical [view] prefix. authority names who wrote the line: FOUNDER_VERBATIM for the founder's review-board comments, AGENT_ADDED for lines an agent added (see authority_contract.render_corrections_source).",
          "items": {
            "type": "object",
            "required": ["text", "authority", "captured"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "authority": { "enum": ["FOUNDER_VERBATIM", "AGENT_ADDED"] },
              "captured": { "type": "string", "format": "date" }
            },
            "additionalProperties": false
          }
        },
        "render_policy": {
          "type": "object",
          "description": "Schema v2: founder keep decisions, folded in from render-keepers.json. A keeper skips one (style, view) render plan in batch runs while its asset still exists; an explicit --sku run still renders it.",
          "required": ["keepers"],
          "properties": {
            "keepers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["style", "view", "asset", "founder_note"],
                "properties": {
                  "style": { "type": "string", "minLength": 1 },
                  "view": { "type": "string", "minLength": 1 },
                  "asset": { "type": "string", "minLength": 1 },
                  "founder_note": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },

        "authority": {
          "description": "v1: one blanket string. v2: per-section provenance so FOUNDER_CONFIRMED stays distinguishable from agent-written copy.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "properties": {
                "garment": { "type": "string" },
                "dossier": { "type": "string" },
                "images": { "type": "string" },
                "content": { "type": "string" },
                "corrections": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },

        "asset_reconciliation": {
          "type": "object",
          "description": "Legacy migration record. Not authored; retire once the asset tree is settled."
        },
        "render_source_migration": {
          "type": "object",
          "description": "Legacy migration record. Not authored; retire once the asset tree is settled."
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "merchandising": ["merchandising_provenance"],
        "merchandising_provenance": ["merchandising"]
      }
    },

    "catalog": {
      "type": "object",
      "description": "Commerce fields. These 24 key names are load-bearing: they are the CSV columns and the PHP array keys the storefront reads. Never rename one.",
      "required": [
        "sku",
        "name",
        "price",
        "collection",
        "description",
        "badge",
        "image",
        "front_model_image",
        "back_image",
        "back_model_image",
        "sizes",
        "color",
        "edition_size",
        "published",
        "is_preorder",
        "branding_spec",
        "render_output_slug",
        "render_source_override",
        "render_back_source_override",
        "render_is_tech_flat",
        "render_is_accessory",
        "garment_type_lock",
        "dossier_slug",
        "engine_override"
      ],
      "properties": {
        "sku": { "$ref": "#/$defs/sku" },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        "collection": { "$ref": "#/$defs/collectionSlug" },
        "description": { "type": "string", "minLength": 1 },
        "badge": { "type": "string" },
        "image": { "type": "string" },
        "front_model_image": { "type": "string" },
        "back_image": { "type": "string" },
        "back_model_image": { "type": "string" },
        "sizes": { "type": "string" },
        "color": { "type": "string" },
        "edition_size": { "type": "string" },
        "published": { "$ref": "#/$defs/boolString" },
        "is_preorder": { "$ref": "#/$defs/boolString" },
        "branding_spec": { "type": "string" },
        "render_output_slug": { "type": "string" },
        "render_source_override": { "type": "string" },
        "render_back_source_override": { "type": "string" },
        "render_is_tech_flat": { "$ref": "#/$defs/boolString" },
        "render_is_accessory": { "$ref": "#/$defs/boolString" },
        "garment_type_lock": { "type": "string" },
        "dossier_slug": { "type": "string", "minLength": 1 },
        "engine_override": { "type": "string" }
      },
      "additionalProperties": false
    },

    "garment": {
      "type": "object",
      "required": [
        "color",
        "available_sizes",
        "fit",
        "materials",
        "features",
        "sizing_references"
      ],
      "properties": {
        "color": { "type": "string" },
        "available_sizes": { "type": "array", "items": { "type": "string" } },
        "fit": { "$ref": "#/$defs/sourcedSpec" },
        "materials": { "$ref": "#/$defs/sourcedSpec" },
        "features": { "$ref": "#/$defs/sourcedSpec" },
        "sizing_references": {
          "type": "object",
          "properties": {
            "decoration_sizing_pointer": { "type": ["string", "null"] },
            "garment_size_chart": { "type": ["string", "null"] },
            "source_rule": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
