{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/paid-api-stopgate.sh'",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/prompt-eng-tripwire.sh'",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*[Cc]ontext7.*query-docs",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/context7-touched.sh'",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Bash|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/learning-tripwire.sh'",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/phpcs-on-write.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/catalog-drift-guard.sh'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/python-format-on-write.sh'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); case \"$fp\" in */frontend/*.ts|*/frontend/*.tsx) root=$(git -C \"$(dirname \"$fp\")\" rev-parse --show-toplevel 2>/dev/null) || exit 0; [ \"$(git -C \"$root\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\" = \"$(git -C \"${CLAUDE_PROJECT_DIR:-/Users/theceo/DevSkyy}\" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)\" ] || exit 0; fe=\"$root/frontend\"; [ -f \"$fe/package.json\" ] || exit 0; if [ ! -x \"$fe/node_modules/.bin/tsc\" ]; then echo \"[tsc-on-write] $fe/node_modules missing — run: cd $fe && npm install (type check skipped)\"; exit 0; fi; cd \"$fe\" && npx tsc --noEmit --pretty false 2>&1 | head -10 ;; esac; true",
            "timeout": 90,
            "statusMessage": "Type-checking frontend"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r fp; [ -z \"$fp\" ] && exit 0; case \"$fp\" in *.py) ruff check \"$fp\" 2>&1 | head -5;; *.php) /opt/homebrew/bin/php -l \"$fp\" 2>&1;; esac; true; }",
            "timeout": 15,
            "statusMessage": "Checking..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/theceo/DevSkyy/.wolf/hooks/memory-audit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash /Users/theceo/DevSkyy/.wolf/hooks/claude-mem-sync.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/theceo/DevSkyy/.codex/hooks/learning-reminder.sh'",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/theceo/DevSkyy/scripts/wolf_recurring_sync.py >/dev/null 2>&1 || echo '[wolf-recurring-sync] FAILED — run python3 scripts/wolf_recurring_sync.py to see the error'; true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
